# =========================================================
# Smart Parking Monorepo - Global .gitignore
# =========================================================

# ---------------------------------------------------------
# OS / Editor / Temp
# ---------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig

# ---------------------------------------------------------
# Secrets / Environment
# ---------------------------------------------------------
.env
.env.*
*.local
*.secret
application-local.yml
application-*.local.yml

# ---------------------------------------------------------
# Logs / Coverage
# ---------------------------------------------------------
*.log
logs/
coverage/

# ---------------------------------------------------------
# Python (APL, python_edge_desktop)
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/

.venv/
venv/
env/
ENV/

# Build / packaging
build/
dist/
site/
pip-wheel-metadata/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# AI model artifacts / large binaries
*.pt
*.onnx
*.weights
*.pb
*.tflite

# ---------------------------------------------------------
# Java / Maven / Gradle (java_spring_core)
# ---------------------------------------------------------
**/target/
**/.gradle/
*.class
*.jar
*.war
*.ear

# Maven wrapper timing / backup files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# ---------------------------------------------------------
# Flutter / Dart (flutter_mobile_app)
# ---------------------------------------------------------
**/.dart_tool/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub/
**/.pub-cache/
**/build/

# Flutter generated
**/flutter_*.log

# Android
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/*.apk
**/android/**/*.aab
**/android/**/*.ap_

# iOS / macOS
**/ios/Flutter/Flutter.framework
**/ios/Flutter/App.framework
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace/xcuserdata/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/Runner.xcworkspace/xcuserdata/

# Windows / Linux generated
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ---------------------------------------------------------
# Node / JS (future-proof)
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# SQL / DB dumps / local data
# ---------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sqlitedb
*.dump
*.bak.sql

# ---------------------------------------------------------
# Optional generated docs backups
# ---------------------------------------------------------
*.md.backup

# ---------------------------------------------------------
# Heavy docs/media files (scoped to docs folders)
# ---------------------------------------------------------
docs/**/*.mp4
docs/**/*.mov
docs/**/*.avi
docs/**/*.mkv
docs/**/*.webm

docs/**/*.psd
docs/**/*.ai
docs/**/*.sketch
docs/**/*.fig

docs/**/*.zip
docs/**/*.7z
docs/**/*.rar
docs/**/*.tar
docs/**/*.gz

document/**/*.mp4
document/**/*.mov
document/**/*.avi
document/**/*.mkv
document/**/*.webm

document/**/*.psd
document/**/*.ai
document/**/*.sketch
document/**/*.fig

document/**/*.zip
document/**/*.7z
document/**/*.rar
document/**/*.tar
document/**/*.gz

